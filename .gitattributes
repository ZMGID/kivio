# Normalize all text files to LF in the repo, regardless of platform checkout
* text=auto eol=lf

# Explicitly mark binary formats so line-ending conversion never touches them
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary

# Protocol codegen output is byte-compared by `npm run protocol:check`.
# The exporter writes LF; without this, autocrlf=true checkouts get CRLF and
# the check fails on Windows (and so do typecheck/build, which chain it).
src/generated/** -text

# Preserve upstream branding bytes and license formatting for provenance hashes.
src-tauri/resources/plugins/icons/* -text whitespace=cr-at-eol,-blank-at-eof
docs/licenses/PandocLogo-CC-BY-SA-4.0.txt -text whitespace=cr-at-eol,-blank-at-eof

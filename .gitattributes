# Normalize all text files to LF in the repo, regardless of platform checkout
* text=auto eol=lf

# Explicitly mark binary formats so line-ending conversion never touches them
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary

# Protocol codegen output is byte-compared by `npm run protocol:check`.
# The exporter writes LF; without this, autocrlf=true checkouts get CRLF and
# the check fails on Windows (and so do typecheck/build, which chain it).
src/generated/** -text

# Preserve upstream branding bytes and license formatting for provenance hashes.
src-tauri/resources/plugins/icons/* -text whitespace=cr-at-eol,-blank-at-eof
docs/licenses/PandocLogo-CC-BY-SA-4.0.txt -text whitespace=cr-at-eol,-blank-at-eof

# Trellis: append-only developer journals should merge cleanly across
# parallel sessions/worktrees — each session only appends a new block, so
# there is nothing to actually conflict on.
#
# Do NOT add a rule for workspace/*/index.md here — it is fully regenerated
# every session, so a real conflict there is expected and safe to resolve by
# picking either side (task state lives in task.json, not index.md). See
# .trellis/spec/cli/backend/directory-structure.md for details.
.trellis/workspace/*/journal-*.md merge=union
